import numpy as np

#1
def calculate_daily_averages(temps):
    return np.mean(temps, axis=1)
#2
def find_hottest_day(temps):
    daily_avg = calculate_daily_averages(temps)
    return np.argmax(daily_avg)
#3
def count_cold_readings(temps, threshold):
    return np.sum(temps < threshold)
#4
def normalize_temperatures(temps):
    min_temp = np.min(temps)
    max_temp = np.max(temps)
    normalized = (temps - min_temp) / (max_temp - min_temp) * 100
    return normalized

# Problem 4
import re

#1
def clean_name(name):
    return name.strip().title()

#2
def validate_email(email):
    email = email.strip()
    
    if email.count('@') != 1:
        return False
    
    local, domain = email.split('@')
    if '.' not in domain or not local or not domain:
        return False
    
    return True

#3
def format_phone(phone):
    digits = re.sub(r'\D', '', phone)
    
    if len(digits) == 10:
        return f"({digits[:3]}) {digits[3:6]}-{digits[6:]}"
    else:
        return "Invalid"
#4
def process_registration(data_string):
    try:
        name, email, phone = data_string.split(',')
    except ValueError:
        return None
    
    name = clean_name(name)
    email = email.strip()
    phone = phone.strip()
    
    if not validate_email(email):
        return None
    
    formatted_phone = format_phone(phone)
    if formatted_phone == "Invalid":
        return None
    
    return {
        "name": name,
        "email": email,
        "phone": formatted_phone
    }
